<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>

    <!-- Adapter selon ta version de pylon (dossier d'installation) -->
    <PylonAssembly>C:\Program Files\Basler\pylon\Development\Assemblies\Basler.Pylon\net472\x64\Basler.Pylon.dll</PylonAssembly>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Basler.Pylon">
      <HintPath>$(PylonAssembly)</HintPath>
    </Reference>
  </ItemGroup>

</Project>
